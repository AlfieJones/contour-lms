# pnpm setup:local writes .env.local with the local Supabase key automatically.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
ADMIN_EMAIL_PATTERNS='["admin@example.com"]'

# Application emails use Supabase's local SMTP inbox. No external provider is needed locally.
APP_URL=http://localhost:3000
EMAIL_SMTP_URL=smtp://127.0.0.1:55325
EMAIL_FROM=noreply@contour.local
EMAIL_FROM_NAME=Contour
