{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/dist/**", "**/.next/**", ".agents/**"],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "plugins": ["react", "nextjs"]
    },
    {
      "files": ["packages/ui/**"],
      "plugins": ["react"]
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  }
}
