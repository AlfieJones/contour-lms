{
  "name": "@lms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./auth-schema": {
      "development": "./src/auth-schema.ts",
      "types": "./dist/auth-schema.d.ts",
      "default": "./dist/auth-schema.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lms/env": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "@next/env": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.5",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
