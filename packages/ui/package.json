{
  "name": "@lms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#lib/*": {
      "types": "./src/lib/*.ts",
      "source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#hooks/*": {
      "types": "./src/hooks/*.ts",
      "source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "#components/*": {
      "types": "./src/components/*.tsx",
      "source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "#components": {
      "types": "./src/components",
      "source": "./src/components",
      "default": "./dist/components"
    },
    "#lib": {
      "types": "./src/lib",
      "source": "./src/lib",
      "default": "./dist/lib"
    },
    "#hooks": {
      "types": "./src/hooks",
      "source": "./src/hooks",
      "default": "./dist/hooks"
    }
  },
  "exports": {
    "./styles.css": "./dist/styles/globals.css",
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
