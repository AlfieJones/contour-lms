{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".oxlintrc.json", ".oxfmtrc.json"],
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "dependsOn": ["@lms/env#build", "@lms/db#build", "@lms/api#build", "@lms/ui#build"],
      "outputs": []
    },
    "//#format": {
      "outputs": []
    },
    "push": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
