{
  "name": "@lms/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./consultation-scheduling": {
      "development": "./src/routers/consultation-scheduling.ts",
      "types": "./dist/routers/consultation-scheduling.d.ts",
      "default": "./dist/routers/consultation-scheduling.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "development": "./src/context.ts",
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./procedures": {
      "development": "./src/procedures.ts",
      "types": "./dist/procedures.d.ts",
      "default": "./dist/procedures.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@lms/db": "workspace:*",
    "@lms/email": "catalog:",
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@orpc/shared": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lms/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
